# ==============================================================================
# GreenTrace 2.0 - Backend Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Option A: Connection Pooler (Port 6543, Recommended for Production / Serverless)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Fallback: SQLite local mode (uncomment to test offline without Supabase)
# DATABASE_PATH=sqlite:///./greentrace.db

# Supabase API Credentials (from Supabase: Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Server & Environment
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 3. Off-Chain Protected Evidence Storage
# ------------------------------------------------------------------------------
UPLOAD_DIRECTORY=./protected_evidence
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 4. CORS Origins (Frontend URLs)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Tezos Blockchain & Indexer (Shadownet Testnet)
# ------------------------------------------------------------------------------
TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
TZKT_API_URL=https://api.shadownet.tzkt.io
CONTRACT_ADDRESS=
ORGANIZER_ADDRESSES=tz1aSkwEkv3Ax2bWZHvCaOKUMcqModq5RMqJ
RECONCILIATION_TIMEOUT=8.0
