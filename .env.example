# ==============================================================================
# GreenTrace 2.0 - Environment Configuration Template
# SECURITY NOTICE: Never store private keys, seed phrases, passwords, or production secrets in this file.
# ==============================================================================

# ==============================================================================
# 1. Supabase & Database Configuration (Backend)
# ==============================================================================
# Supabase PostgreSQL URI (Settings -> Database -> Connection string -> URI)
# Option A: Connection Pooler (Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Option B: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Local fallback (if DATABASE_URL is not set)
DATABASE_PATH=sqlite:///./greentrace.db

# Supabase API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ==============================================================================
# 2. Frontend Configuration (Vite environment variables prefixed with VITE_)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_TEZOS_NETWORK=shadownet
VITE_TEZOS_NETWORK_NAME=Shadownet (Tezos Testnet)
VITE_TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
VITE_EXPLORER_URL=https://shadownet.tzkt.io
VITE_CONTRACT_ADDRESS=
VITE_ORGANIZER_ADDRESSES=tz1aSkwEkv3Ax2bWZHvCaOKUMcqModq5RMqJ

# Optional Frontend Supabase Integration (if needed in client)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# 3. Backend Server Configuration (FastAPI)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
UPLOAD_DIRECTORY=./protected_evidence
MAX_UPLOAD_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
TZKT_API_URL=https://api.shadownet.tzkt.io
ORGANIZER_ADDRESSES=tz1aSkwEkv3Ax2bWZHvCaOKUMcqModq5RMqJ
RECONCILIATION_TIMEOUT=8.0
