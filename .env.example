# GreenTrace 2.0 - Environment Configuration Template
# SECURITY NOTICE: Never store private keys, seed phrases, passwords, or production secrets in this file.

# =====================================================================
# Frontend Configuration (Vite environment variables prefixed with VITE_)
# =====================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_TEZOS_NETWORK=shadownet
VITE_TEZOS_NETWORK_NAME=Shadownet (Tezos Testnet)
VITE_TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
VITE_EXPLORER_URL=https://shadownet.tzkt.io
# Deployed KT1 contract address on Tezos Shadownet (leave empty if not yet originated)
VITE_CONTRACT_ADDRESS=
# Authorized organizer wallet public key hashes (comma-separated tz1 addresses)
VITE_ORGANIZER_ADDRESSES=tz1aSkwEkv3Ax2bWZHvCaOKUMcqModq5RMqJ,tz1VSUr8wwNhLAzempoch5d6hLRiTh8Cjcjb

# =====================================================================
# Backend Configuration (FastAPI)
# =====================================================================
DATABASE_PATH=./greentrace.db
UPLOAD_DIRECTORY=./protected_evidence
MAX_UPLOAD_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
TZKT_API_URL=https://api.shadownet.tzkt.io
RECONCILIATION_TIMEOUT=8.0
