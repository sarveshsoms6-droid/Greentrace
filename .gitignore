# ==============================================================================
# GreenTrace 2.0 - Comprehensive .gitignore
# Prevents sensitive credentials, database files, binary weights, and build artifacts
# from being committed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
*.env.staging

# Private Keys, Certificates, & Credentials
*.pem
*.key
*.pk
*.p12
*.pfx
*.cert
*.crt
id_rsa*
*.id
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Database & Storage Files
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
greentrace.db
backend/greentrace.db
test_*.db

# ------------------------------------------------------------------------------
# 3. Off-Chain Protected Evidence & Uploads
# ------------------------------------------------------------------------------
protected_evidence/
backend/protected_evidence/
uploads/
backend/uploads/
uploads/annotated/
backend/uploads/annotated/

# ------------------------------------------------------------------------------
# 4. Large AI Models & Heavy Binary Weights (>25MB - 350MB)
# (YOLO-World automatically fetches official weights on first startup)
# ------------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
weights/
yolov8s-worldv2.pt

# ------------------------------------------------------------------------------
# 5. Node.js & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.npm/
.vite/
frontend/.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Python Virtual Environments & Bytecode Cache
# ------------------------------------------------------------------------------
.venv/
backend/.venv/
env/
venv/
ENV/
__pycache__/
backend/**/__pycache__/
contracts/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
